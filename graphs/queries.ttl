}
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/15> a shui:SparqlQuery ;
  rdfs:label "What is the cheapest Encoder we can get from a french or german supplier?" ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/FILTER>, <https://text2sparql.aksw.org/2025/corporate/queries/features/LIMIT>, <https://text2sparql.aksw.org/2025/corporate/queries/features/ORDER>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Price, pv:Product, pv:ProductCategory, pv:Supplier ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:addressCountry, pv:amount, pv:hasCategory, pv:hasSupplier, pv:price ;
  ns2:created "2026-01-31T07:52:01.490Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.490Z"^^xsd:dateTime ;
  shui:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE
{
  ?result pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Encoder> .
  ?result pv:price ?priceR .
  ?priceR pv:amount ?price .
  ?result pv:hasSupplier ?supplier .
  ?supplier pv:addressCountry ?country .
  FILTER ( (?country = "France") ||  (?country = "Germany") )
}
ORDER BY ASC(?price)
LIMIT 1
""" ;
  shui:queryType "SELECT" .

