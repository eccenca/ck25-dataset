<https://text2sparql.aksw.org/2025/corporate/queries/21> a shui:SparqlQuery ;
  rdfs:label "What is the heaviest coil that does not exceed a base area of 15x15 milimeter?" ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/LIMIT>, <https://text2sparql.aksw.org/2025/corporate/queries/features/ORDER>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Product, pv:ProductCategory ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:depth_mm, pv:hasCategory, pv:weight_g, pv:width_mm ;
  ns2:created "2026-01-31T07:52:01.493Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.493Z"^^xsd:dateTime ;
  shui:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE
{
  ?result pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Coil> .
  ?result pv:weight_g ?weight_g .
  ?result pv:width_mm ?width_mm .
  ?result pv:depth_mm ?depth_mm .
  FILTER (?width_mm <= 15)
  FILTER (?depth_mm <= 15)
}
ORDER BY DESC(?weight_g)
LIMIT 1
""" ;
  shui:queryType "SELECT" .

