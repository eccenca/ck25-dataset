  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/49> a shui:SparqlQuery ;
  rdfs:label "How many suppliers can deliver alternative compatible products for the K367 Strain Encoder?" ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/COUNT>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Product, pv:Supplier ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:compatibleProduct, pv:hasSupplier ;
  ns2:created "2026-01-31T07:52:01.504Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.504Z"^^xsd:dateTime ;
  shui:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT (COUNT(?supplier) AS ?result)
WHERE
{
  <http://ld.company.org/prod-instances/hw-K367-1320550> pv:compatibleProduct ?alternative .
  ?alternative pv:hasSupplier ?supplier .
}
""" ;
  shui:queryType "SELECT" .

