<https://text2sparql.aksw.org/2025/corporate/queries/13> a shui:SparqlQuery ;
  rdfs:label "How many suppliers do we have in France?" ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/COUNT>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Product, pv:Supplier ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:addressCountry, pv:hasSupplier ;
  ns2:created "2026-01-31T07:52:01.489Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.489Z"^^xsd:dateTime ;
  shui:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT (COUNT(DISTINCT ?supplier) as ?result)
WHERE
{
  ?product pv:hasSupplier ?supplier .
  ?supplier pv:addressCountry "France" .
}
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/14> a shui:SparqlQuery ;
  rdfs:label "Which supplier in France delivers Compensators?" ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Product, pv:ProductCategory, pv:Supplier ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:addressCountry, pv:hasCategory, pv:hasSupplier ;
  ns2:created "2026-01-31T07:52:01.489Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.489Z"^^xsd:dateTime ;
  shui:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE
{
  ?product pv:hasSupplier ?result .
  ?product pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Compensator> .
