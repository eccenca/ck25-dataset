<https://text2sparql.aksw.org/2025/corporate/queries/50> a shui:SparqlQuery ;
  rdfs:label "Which department is resposible for the most product and how many product are this?" ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/COUNT>, <https://text2sparql.aksw.org/2025/corporate/queries/features/GROUP>, <https://text2sparql.aksw.org/2025/corporate/queries/features/LIMIT>, <https://text2sparql.aksw.org/2025/corporate/queries/features/ORDER>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Department, pv:Product ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:responsibleFor ;
  ns2:created "2026-01-31T07:52:01.504Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.504Z"^^xsd:dateTime ;
  shui:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result (COUNT(?result) AS ?count)
WHERE
{
  ?result pv:responsibleFor ?product .
}
GROUP BY ?result
ORDER BY DESC(?count)
LIMIT 1
""" ;
  shui:queryType "SELECT" .

