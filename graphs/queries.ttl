<https://text2sparql.aksw.org/2025/corporate/queries/24> a shui:SparqlQuery ;
  rdfs:label "What is the pontiometer with the smallest volume?" ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/BIND>, <https://text2sparql.aksw.org/2025/corporate/queries/features/LIMIT>, <https://text2sparql.aksw.org/2025/corporate/queries/features/ORDER>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Product, pv:ProductCategory ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:depth_mm, pv:hasCategory, pv:height_mm, pv:width_mm ;
  ns2:created "2026-01-31T07:52:01.494Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.494Z"^^xsd:dateTime ;
  shui:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE
{
  ?result pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Potentiometer> .
  ?result pv:width_mm ?width_mm .
  ?result pv:depth_mm ?depth_mm .
  ?result pv:height_mm ?height_mm .
  BIND(?width_mm * ?depth_mm * ?height_mm as ?volume)
}
ORDER BY ASC(?volume)
LIMIT 1
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/25> a shui:SparqlQuery ;
  rdfs:label "Which coil has the highest density?" ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/BIND>, <https://text2sparql.aksw.org/2025/corporate/queries/features/LIMIT>, <https://text2sparql.aksw.org/2025/corporate/queries/features/ORDER>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Product, pv:ProductCategory ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:depth_mm, pv:hasCategory, pv:height_mm, pv:weight_g, pv:width_mm ;
  ns2:created "2026-01-31T07:52:01.495Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.495Z"^^xsd:dateTime ;
  shui:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE
{
  ?result pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Coil> .
  ?result pv:width_mm ?width_mm .
  ?result pv:depth_mm ?depth_mm .
  ?result pv:height_mm ?height_mm .
  ?result pv:weight_g ?weight_g .
  BIND(?width_mm * ?depth_mm * ?height_mm / 1000000000 AS ?volume_m3)
  BIND(?weight_g / 1000 AS ?weight_kg)
  BIND(?weight_kg / ?volume_m3 AS ?density)
}
ORDER BY DESC(?density)
LIMIT 1
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/26> a shui:SparqlQuery ;
  rdfs:label "In which cities are our US suppliers for LCDs?" ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:ProductCategory, pv:Supplier ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:addressLocality, pv:country, pv:hasCategory, pv:hasSupplier ;
  ns2:created "2026-01-31T07:52:01.495Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.495Z"^^xsd:dateTime ;
  shui:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE
{
  ?product pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-LCD> .
  ?product pv:hasSupplier ?supplier .
  ?supplier pv:country <http://dbpedia.org/resource/United_States> .
  ?supplier pv:addressLocality ?result .
}
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/27> a shui:SparqlQuery ;
  rdfs:label "Give me a phone directory of everyone on staff who does not manage anyone, I need name, email, and phone, sorted by name?" ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/EXISTS>, <https://text2sparql.aksw.org/2025/corporate/queries/features/OPTIONAL>, <https://text2sparql.aksw.org/2025/corporate/queries/features/ORDER>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Employee ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:email, pv:hasManager, pv:name, pv:phone ;
  ns2:created "2026-01-31T07:52:01.495Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.495Z"^^xsd:dateTime ;
  shui:queryText """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?empl ?name ?email ?phone
WHERE {
  ?emplClass rdfs:subClassOf* pv:Employee .
  ?empl a ?emplClass ;
      pv:name ?name ;
      pv:email ?email .
  OPTIONAL { ?empl pv:phone ?phone }
  FILTER NOT EXISTS { [] pv:hasManager ?empl . }
}
ORDER BY ?name
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/28> a shui:SparqlQuery ;
  rdfs:label "Do we have any service that does apply to a BOM where parts are sourced from Russia?" ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/ASK>, <https://text2sparql.aksw.org/2025/corporate/queries/features/FILTER>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SUBSELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:BillOfMaterial, pv:BomPart, pv:Hardware, pv:Service, pv:Supplier ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:addressCountry, pv:eligibleFor, pv:hasBomPart, pv:hasPart, pv:hasSupplier ;
  ns2:created "2026-01-31T07:52:01.496Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.496Z"^^xsd:dateTime ;
  shui:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

ASK
WHERE {
  { # all BOMs with parts from russia
    SELECT ?bom
    WHERE {
      ?bom pv:hasBomPart ?bomPart .
      ?bomPart pv:hasPart ?hw .
      ?hw pv:hasSupplier ?suppl .
      ?suppl pv:addressCountry ?country .
      FILTER (CONTAINS(LCASE(?country), LCASE("Russia")))
    }
  }

  # services eligible for parts associated with these BOMs?
  ?s a pv:Service .
  ?s pv:eligibleFor ?hw .
  ?bom pv:hasBomPart ?bomPart .
  ?bomPart pv:hasPart ?hw .
}
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/29> a shui:SparqlQuery ;
  rdfs:label "What suppliers - I need name, country and price - deliver the 6th to 10th most expensive hardware items." ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/LIMIT>, <https://text2sparql.aksw.org/2025/corporate/queries/features/OFFSET>, <https://text2sparql.aksw.org/2025/corporate/queries/features/ORDER>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Hardware, pv:Price, pv:Supplier ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:addressCountry, pv:amount, pv:currency, pv:hasSupplier, pv:name ;
  ns2:created "2026-01-31T07:52:01.496Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.496Z"^^xsd:dateTime ;
  shui:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?name ?country ?price
WHERE {
  ?sup a pv:Supplier ;
    pv:addressCountry ?country ;
  pv:name ?name .
  ?hw a pv:Hardware ;
  pv:price/pv:amount ?price ;
    pv:price/pv:currency "EUR" ;
    pv:hasSupplier ?sup .
}
ORDER BY DESC(?price)
LIMIT 5 OFFSET 10
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/3> a shui:SparqlQuery ;
  rdfs:label "Who is the manager of Heinrich Hoch?" ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Employee, pv:Manager ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:hasManager ;
  ns2:created "2026-01-31T07:52:01.484Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.484Z"^^xsd:dateTime ;
  shui:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE
{
  <http://ld.company.org/prod-instances/empl-Heinrich.Hoch%40company.org> pv:hasManager ?result .
}
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/30> a shui:SparqlQuery ;
  rdfs:label "Which department have more than 5 employees? I need their names and the number of employees." ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/COUNT>, <https://text2sparql.aksw.org/2025/corporate/queries/features/GROUP>, <https://text2sparql.aksw.org/2025/corporate/queries/features/HAVING>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Department, pv:Employee ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:memberOf, pv:name ;
  ns2:created "2026-01-31T07:52:01.497Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.497Z"^^xsd:dateTime ;
  shui:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?name (COUNT(?emp) AS ?numEmployees)
WHERE {
  ?dept a pv:Department ;
    pv:name ?name .
  ?emp a pv:Employee ;
    pv:memberOf ?dept .
}
GROUP BY ?depty ?name
HAVING (COUNT(?emp) > 5)
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/31> a shui:SparqlQuery ;
  rdfs:label "Per product category, what's our lightest and heaviest hardware item?" ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/GROUP>, <https://text2sparql.aksw.org/2025/corporate/queries/features/MAX>, <https://text2sparql.aksw.org/2025/corporate/queries/features/MIN>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Hardware, pv:ProductCategory ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:hasCategory, pv:name, pv:weight_g ;
  ns2:created "2026-01-31T07:52:01.497Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.497Z"^^xsd:dateTime ;
  shui:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?cat (MIN(?w) AS ?minWeight) (MAX(?w) AS ?maxWeight)
WHERE {
  ?catItem a pv:ProductCategory ;
    pv:name ?cat .
  ?hw a pv:Hardware ;
    pv:hasCategory ?catItem ;
    pv:weight_g ?w .
}
GROUP BY ?cat
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/32> a shui:SparqlQuery ;
  rdfs:label "For each supplier, what's the average price (in EUR) of what they sell, round reasonably?" ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/AVG>, <https://text2sparql.aksw.org/2025/corporate/queries/features/GROUP>, <https://text2sparql.aksw.org/2025/corporate/queries/features/ROUND>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Hardware, pv:Price, pv:Supplier ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:amount, pv:currency, pv:hasSupplier, pv:name, pv:price ;
  ns2:created "2026-01-31T07:52:01.497Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.497Z"^^xsd:dateTime ;
  shui:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?name (ROUND(AVG(?amt) * 100) / 100 AS ?avgEur) WHERE {
  ?sup a pv:Supplier ;
    pv:name ?name .
  ?hw pv:hasSupplier ?sup ;
    pv:price/pv:amount ?amt ;
    pv:price/pv:currency "EUR" .
}
GROUP BY ?sup ?name
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/33> a shui:SparqlQuery ;
  rdfs:label "Are there departments with no manager assigned?" ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/ASK>, <https://text2sparql.aksw.org/2025/corporate/queries/features/EXISTS> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Department, pv:Manager ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:memberOf ;
  ns2:created "2026-01-31T07:52:01.498Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.498Z"^^xsd:dateTime ;
  shui:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

ASK
WHERE {
  ?dept a pv:Department .
  FILTER NOT EXISTS {
    ?m pv:memberOf ?dept .
    ?m a pv:Manager .
  }
}
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/34> a shui:SparqlQuery ;
  rdfs:label "I need to update my supplier rolodex, give me every supplier's name and all address details." ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/OPTIONAL>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Supplier ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:addressCountry, pv:addressCountryCode, pv:addressLocality, pv:name ;
  ns2:created "2026-01-31T07:52:01.498Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.498Z"^^xsd:dateTime ;
  shui:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?name ?locality ?ccode ?country
WHERE {
  ?sup a pv:Supplier ;
    pv:name ?name .
  OPTIONAL { ?sup pv:addressLocality ?locality . }
  OPTIONAL { ?sup pv:addressCountryCode ?ccode . }
  OPTIONAL { ?sup pv:addressCountry ?country . }
}
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/35> a shui:SparqlQuery ;
  rdfs:label "For every product, list what other products it is compatible with and the price differences between both." ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Price, pv:Product ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:amount, pv:compatibleProduct, pv:currency, pv:price, pv:rdfssubClassOf ;
  ns2:created "2026-01-31T07:52:01.498Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.498Z"^^xsd:dateTime ;
  shui:queryText """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv:    <http://ld.company.org/prod-vocab/>

SELECT ?prod ?compatible (?prodAmount - ?compatibleAmount AS ?priceDiff)
WHERE {
  ?prodClass rdfs:subClassOf* pv:Product .
  ?prod a ?prodClass ;
    pv:compatibleProduct ?compatible .
  ?prod pv:price/pv:amount ?prodAmount ;
    pv:price/pv:currency "EUR" .
  ?compatible pv:price/pv:amount ?compatibleAmount ;
    pv:price/pv:currency "EUR" .
}
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/36> a shui:SparqlQuery ;
  rdfs:label "Which area of expertise is most relevant among our products, what are the top three skills?" ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/COUNT>, <https://text2sparql.aksw.org/2025/corporate/queries/features/GROUP>, <https://text2sparql.aksw.org/2025/corporate/queries/features/LIMIT>, <https://text2sparql.aksw.org/2025/corporate/queries/features/ORDER>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Hardware, pv:ProductCategory ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:hasCategory, pv:name ;
  ns2:created "2026-01-31T07:52:01.499Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.499Z"^^xsd:dateTime ;
  shui:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?cat ?name
WHERE {
  ?hw a pv:Hardware ;
    pv:hasCategory ?cat .
  ?cat pv:name ?name .
}
GROUP BY ?cat ?name
ORDER BY DESC(COUNT(*))
LIMIT 3
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/37> a shui:SparqlQuery ;
  rdfs:label "For each Bill of Material, how many parts does it contain and what is the total material quantity — show me only those BOMs exceeding 600 total items and order them descending." ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/BIND>, <https://text2sparql.aksw.org/2025/corporate/queries/features/COUNT>, <https://text2sparql.aksw.org/2025/corporate/queries/features/GROUP>, <https://text2sparql.aksw.org/2025/corporate/queries/features/HAVING>, <https://text2sparql.aksw.org/2025/corporate/queries/features/ORDER>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SUM> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:BillOfMaterial, pv:BomPart ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:hasBomPart, pv:quantity ;
  ns2:created "2026-01-31T07:52:01.499Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.499Z"^^xsd:dateTime ;
  shui:queryText """PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?bom (COUNT(?part) AS ?partCount) (SUM(?qty) AS ?totalQty)
WHERE {
  ?bom a pv:BillOfMaterial ;
    pv:hasBomPart ?part .
  ?part pv:quantity ?qty_ .
  BIND(xsd:int(?qty_) AS ?qty)
}
GROUP BY ?bom
HAVING (SUM(?qty) > 600)
ORDER BY DESC(SUM(?qty))
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/38> a shui:SparqlQuery ;
  rdfs:label "I want to update my contact list, for each Employee give me name, email, phone number and the department they belong to as well as their direct report." ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/OPTIONAL>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Agent, pv:Department, pv:Employee, pv:Manager ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:email, pv:hasManager, pv:memberOf, pv:name, pv:phone, pv:rdfssubClassOf ;
  ns2:created "2026-01-31T07:52:01.499Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.499Z"^^xsd:dateTime ;
  shui:queryText """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?name ?email ?phone ?dept ?manager
WHERE {
  ?agentClass rdfs:subClassOf* pv:Agent .
  ?empl a ?agentClass ;
    pv:name ?name .
  OPTIONAL { ?empl pv:email ?email . }
  OPTIONAL { ?empl pv:phone ?phone . }
  OPTIONAL { ?empl pv:memberOf/pv:name ?dept . }
  OPTIONAL { ?empl pv:hasManager/pv:name ?manager . }
}
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/39> a shui:SparqlQuery ;
  rdfs:label "Which hardware items are wider than they are tall, and have a depth under 50 mm? List their dimensions." ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/FILTER>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Hardware ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:depth_mm, pv:height_mm, pv:width_mm ;
  ns2:created "2026-01-31T07:52:01.500Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.500Z"^^xsd:dateTime ;
  shui:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?hw ?width ?height ?depth
WHERE {
  ?hw a pv:Hardware ;
    pv:width_mm ?width ;
    pv:height_mm ?height ;
    pv:depth_mm ?depth .
  FILTER (?width > ?height && ?depth < 50)
}
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/4> a shui:SparqlQuery ;
  rdfs:label "What is the email of Sabrina from Marketing?" ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Department, pv:Employee ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:email, pv:memberOf, pv:name ;
  ns2:created "2026-01-31T07:52:01.484Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.484Z"^^xsd:dateTime ;
  shui:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE
{
  ?department pv:name "Marketing" .
  ?person pv:memberOf ?department .
  ?person pv:email ?result .
  ?person pv:name ?name .
  FILTER (CONTAINS(?name, "Sabrina"))
}
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/40> a shui:SparqlQuery ;
  rdfs:label "Which hardware items - list id and name - have no active product manager?" ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/EXISTS>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Agent, pv:Hardware ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:hasProductManager, pv:id, pv:name ;
  ns2:created "2026-01-31T07:52:01.500Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.500Z"^^xsd:dateTime ;
  shui:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?hw ?id ?name
WHERE {
  ?hw a pv:Hardware ;
    pv:id ?id ;
    pv:name ?name .
  FILTER NOT EXISTS { ?hw pv:hasProductManager/pv:name [] . }
}
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/41> a shui:SparqlQuery ;
  rdfs:label "For each manager, what percentage of their entire team work in the same department as the manager?" ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/COUNT>, <https://text2sparql.aksw.org/2025/corporate/queries/features/GROUP>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SUBSELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Agent, pv:Department, pv:Manager ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:hasManager, pv:memberOf, pv:name ;
  ns2:created "2026-01-31T07:52:01.501Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.501Z"^^xsd:dateTime ;
  shui:queryText """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?m ?name (?deptTeam / ?fullteam * 100 AS ?pct)
WHERE {

  ?m pv:name ?name .

  { # full team
    SELECT ?m (COUNT(*) AS ?fullteam) WHERE {
      ?e pv:hasManager ?m .
    } GROUP BY ?m
  }

  { # team in same dept
    SELECT ?m (COUNT(*) AS ?deptTeam) WHERE {
      ?m pv:memberOf ?dept .
      ?e pv:hasManager ?m .
      ?e pv:memberOf ?dept .
    } GROUP BY ?m
  }
}
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/42> a shui:SparqlQuery ;
  rdfs:label "Which Bill-of-Material has the highest average unit cost of its hardware parts, and what is that average?" ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/AVG>, <https://text2sparql.aksw.org/2025/corporate/queries/features/BIND>, <https://text2sparql.aksw.org/2025/corporate/queries/features/GROUP>, <https://text2sparql.aksw.org/2025/corporate/queries/features/LIMIT>, <https://text2sparql.aksw.org/2025/corporate/queries/features/ORDER>, <https://text2sparql.aksw.org/2025/corporate/queries/features/ROUND>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SUBSELECT>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SUM> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:BillOfMaterial, pv:BomPart, pv:Hardware, pv:Price ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:amount, pv:currency, pv:hasBomPart, pv:hasPart, pv:price, pv:quantity ;
  ns2:created "2026-01-31T07:52:01.501Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.501Z"^^xsd:dateTime ;
  shui:queryText """PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?bom (ROUND(AVG(?spst / ?sq) * 100) / 100 AS ?avgUnitCost)
WHERE {
  {
    SELECT ?bom (SUM(?partSubTotal) AS ?spst) (SUM(xsd:int(?quant)) AS ?sq)
    WHERE {
      ?bom a pv:BillOfMaterial ;
        pv:hasBomPart ?part .
      ?part pv:quantity ?quant .
      ?part pv:hasPart/pv:price/pv:amount ?amount .
      ?part pv:hasPart/pv:price/pv:currency "EUR" .
      BIND(xsd:int(?quant) * ?amount AS ?partSubTotal)
    }
    GROUP BY ?bom
  }
}
GROUP BY ?bom
ORDER BY DESC(?avgUnitCost)
LIMIT 1
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/43> a shui:SparqlQuery ;
  rdfs:label "Show me any cycles of product compatibility — i.e. product A says it's compatible with B, and B says it's compatible with A (mutual pairs)." ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/FILTER>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Hardware ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:compatibleProduct ;
  ns2:created "2026-01-31T07:52:01.501Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.501Z"^^xsd:dateTime ;
  shui:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?a ?b
WHERE {
  ?a pv:compatibleProduct ?b .
  FILTER (STR(?a) < STR(?b))
}
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/44> a shui:SparqlQuery ;
  rdfs:label "Which hardware items have dimensions in the top 10 % of all widths, and what are their IDs, names and widths?" ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/BIND>, <https://text2sparql.aksw.org/2025/corporate/queries/features/FILTER>, <https://text2sparql.aksw.org/2025/corporate/queries/features/MAX>, <https://text2sparql.aksw.org/2025/corporate/queries/features/MIN>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SUBSELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Hardware ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:compatibleProduct, pv:id, pv:name, pv:width_mm ;
  ns2:created "2026-01-31T07:52:01.502Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.502Z"^^xsd:dateTime ;
  shui:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?id ?name ?width
WHERE {
  { # get min-max range
    SELECT (MIN(?width) AS ?minW) (MAX(?width) AS ?maxW)
    WHERE {
      ?hw a pv:Hardware ;
        pv:width_mm ?width .
    }
  }

  # get 90. percentile
  BIND(?minW + (0.9 * (?maxW - ?minW)) AS ?pct90)

  ?hw a pv:Hardware ;
    pv:id ?id ;
    pv:name ?name ;
    pv:width_mm ?width .

  FILTER(?width >= ?pct90)
}
ORDER BY DESC(?width)
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/45> a shui:SparqlQuery ;
  rdfs:label "Which supplier delivers the most reliable Inductor?" ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/LIMIT>, <https://text2sparql.aksw.org/2025/corporate/queries/features/ORDER>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Hardware, pv:ProductCategory, pv:Supplier ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:hasCategory, pv:hasSupplier, pv:reliabilityIndex ;
  ns2:created "2026-01-31T07:52:01.502Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.502Z"^^xsd:dateTime ;
  shui:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE
{
  ?hardware pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Inductor> .
  ?hardware pv:reliabilityIndex ?reliabilityIndex .
  ?hardware pv:hasSupplier ?result .
}
ORDER BY DESC(?reliabilityIndex)
LIMIT 1
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/46> a shui:SparqlQuery ;
  rdfs:label "What are the top 5 suppliers with best average reliability over their products." ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/AVG>, <https://text2sparql.aksw.org/2025/corporate/queries/features/GROUP>, <https://text2sparql.aksw.org/2025/corporate/queries/features/LIMIT>, <https://text2sparql.aksw.org/2025/corporate/queries/features/ORDER>, <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:Product, pv:Supplier ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:hasSupplier, pv:reliabilityIndex ;
  ns2:created "2026-01-31T07:52:01.503Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.503Z"^^xsd:dateTime ;
  shui:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result (AVG(?reliabilityIndex) AS ?averageReliabilityIndex)
WHERE
{
  ?hardware pv:reliabilityIndex ?reliabilityIndex .
  ?hardware pv:hasSupplier ?result .
}
GROUP BY ?result
ORDER BY DESC(?averageReliabilityIndex)
LIMIT 5
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/47> a shui:SparqlQuery ;
  rdfs:label "From which countries are the BOM parts of our SkySync MechWave delivered?" ;
  <https://text2sparql.aksw.org/2025/corporate/queries/feature> <https://text2sparql.aksw.org/2025/corporate/queries/features/SELECT> ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedClass> pv:BillOfMaterial, pv:BomPart, pv:Product, pv:Supplier ;
  <https://text2sparql.aksw.org/2025/corporate/queries/relatedProperty> pv:country, pv:hasBomPart, pv:hasPart, pv:hasSupplier ;
  ns2:created "2026-01-31T07:52:01.503Z"^^xsd:dateTime ;
  ns2:modified "2026-01-31T07:52:01.503Z"^^xsd:dateTime ;
  shui:queryText """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE
{
  <http://ld.company.org/prod-instances/bom-17> pv:hasBomPart ?bomPart .
  ?bomPart pv:hasPart ?product .
  ?product pv:hasSupplier ?supplier .
  ?supplier pv:country ?result
}
""" ;
  shui:queryType "SELECT" .

<https://text2sparql.aksw.org/2025/corporate/queries/48> a shui:SparqlQuery ;
  rdfs:label "Show me all BOMs which have at least on part from a polish supplier." ;
